PORT=8080
REDIS_URL=redis://localhost:6379
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER_ID=solana-devnet
# Required before submission is enabled; pin to the trusted RPC getGenesisHash response.
SOLANA_EXPECTED_GENESIS_HASH=
ENABLE_LIVE_SUBMISSION=false
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
DRY_RUN=true
MAX_ORDER_USD=10000
MAX_SLIPPAGE_BPS=100
MAX_ROUTE_DRIFT_RATIO=0.15
MAX_PRIORITY_FEE_LAMPORTS=10000
RPC_TIMEOUT_MS=5000
ENABLE_ROUTE_CONSISTENCY_GUARD=true
QUOTE_PROVIDER_RETRY_COUNT=2
QUOTE_PROVIDER_RETRY_DELAY_MS=150
QUOTE_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=3
QUOTE_PROVIDER_CIRCUIT_BREAKER_RESET_MS=60000
TX_NONCE_MAX_AGE_MS=300000
# JSON credential registry. Store only SHA-256 hashes of random 32-byte secrets.
# Wire token format: <id>.<secret>. See docs/API.md for generation/rotation.
API_AUTH_TOKENS=[]
# SHA-256 fingerprint of the AWS Nitro Enclaves root CA certificate, without colons.
NITRO_TRUSTED_ROOT_SHA256=
# PCR allowlist must be populated from approved EIF and parent-role measurements.
NITRO_PCR3_P1=
NITRO_PCR3_P2=
NITRO_PCR3_P3=
NITRO_PCR3_COORDINATOR=
NITRO_PCR4_P1=
NITRO_PCR4_P2=
NITRO_PCR4_P3=
NITRO_PCR4_COORDINATOR=
NITRO_PCR8=
ATTESTATION_CHALLENGE_TTL_SECONDS=60
ATTESTATION_MAX_AGE_MS=60000
# Stable KMS-wrapped signing-seed epoch identifier used in approval/signing bindings.
NITRO_SIGNING_KEY_ID=
NITRO_EXPECTED_PUBLIC_KEY_HEX=
# Raw Ed25519 public key of the external policy authorization issuer (64 hex chars).
POLICY_AUTHORITY_PUBLIC_KEY_HEX=
# Linux Nitro parent only
NITRO_ENCLAVE_CID=16
NITRO_VSOCK_PORT=5000
NITRO_VSOCK_CLIENT=nitro/parent/vsock_client.py
PYTHON_BIN=python3
