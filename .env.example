PORT=8080
REDIS_URL=redis://localhost:6379
SOLANA_RPC_URL=https://api.devnet.solana.com
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
DRY_RUN=true
MAX_ORDER_USD=10000
MAX_SLIPPAGE_BPS=100
MAX_ROUTE_DRIFT_RATIO=0.15
MAX_PRIORITY_FEE_LAMPORTS=10000
RPC_TIMEOUT_MS=5000
ENABLE_ROUTE_CONSISTENCY_GUARD=true
# Path to compiled real FROST signer binary
MPC_BIN=mpc/frost-signer/target/release/dflow-frost-signer
# Linux Nitro parent only
NITRO_ENCLAVE_CID=16
NITRO_VSOCK_PORT=5000
NITRO_VSOCK_CLIENT=nitro/parent/vsock_client.py
PYTHON_BIN=python3
