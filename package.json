{
  "name": "mini-dflow-realworld",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit",
    "check:redis": "node scripts/check-redis.mjs",
    "check:participant-policy": "node scripts/check-participant-policy.mjs",
    "redis:up": "node scripts/start-redis.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "express": "^5.1.0",
    "ioredis": "^5.8.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
